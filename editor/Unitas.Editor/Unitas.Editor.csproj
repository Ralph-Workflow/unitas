<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unitas.Editor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unitas.Editor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../bridge/Unitas.Bridge/Unitas.Bridge.csproj" />
    <ProjectReference Include="../../bridge/Unitas.Debugging/Unitas.Debugging.csproj" />
    <ProjectReference Include="../../bridge/Unitas.Scripting/Unitas.Scripting.csproj" />
    <ProjectReference Include="../../bridge/Unitas.Testing/Unitas.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../target/debug/libunitas_runtime.dylib" Condition="Exists('../../target/debug/libunitas_runtime.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libunitas_runtime.dylib</Link>
    </None>
    <None Include="../../target/debug/libunitas_runtime.so" Condition="Exists('../../target/debug/libunitas_runtime.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libunitas_runtime.so</Link>
    </None>
    <None Include="../../target/debug/unitas_runtime.dll" Condition="Exists('../../target/debug/unitas_runtime.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>unitas_runtime.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

</Project>
